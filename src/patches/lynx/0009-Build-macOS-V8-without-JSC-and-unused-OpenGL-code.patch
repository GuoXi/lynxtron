From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Guo Xi <guoxi.gx@bytedance.com>
Date: Tue, 29 Sep 2026 23:05:37 +0800
Subject: [PATCH] Build macOS V8 without JSC and unused OpenGL code

---
diff --git a/clay/gfx/shared_image/BUILD.gn b/clay/gfx/shared_image/BUILD.gn
index c7b33e8d..038c67f2 100644
--- a/clay/gfx/shared_image/BUILD.gn
+++ b/clay/gfx/shared_image/BUILD.gn
@@ -3,6 +3,7 @@
 # LICENSE file in the root directory of this source tree.
 
 import("../../common/config.gni")
+import("../../shell/config.gni")
 
 # Linux Skity currently supports only software rendering through ANGLE
 # SwiftShader.
@@ -96,12 +97,13 @@ source_set("shared_image") {
 
     cflags_objcc = [ "-fobjc-weak" ]  # tweak Skia include files
 
-    if (is_mac) {
+    if (is_mac && shell_enable_gl) {
       sources += [
         "cgl_image_representation.h",
         "cgl_image_representation.mm",
       ]
 
+      defines += [ "CLAY_ENABLE_CGL" ]
       frameworks += [ "OpenGL.framework" ]
     }
 
diff --git a/clay/gfx/shared_image/cv_pixelbuffer_image_backing.mm b/clay/gfx/shared_image/cv_pixelbuffer_image_backing.mm
index ca7b8394..f1d54c8f 100644
--- a/clay/gfx/shared_image/cv_pixelbuffer_image_backing.mm
+++ b/clay/gfx/shared_image/cv_pixelbuffer_image_backing.mm
@@ -15,7 +15,7 @@
 #include "clay/gfx/shared_image/eagl_image_representation.h"
 #endif
 
-#if OS_MAC
+#if OS_MAC && defined(CLAY_ENABLE_CGL)
 #include "clay/gfx/shared_image/cgl_image_representation.h"
 #endif
 
@@ -76,7 +76,7 @@ fml::RefPtr<SharedImageRepresentation> CVPixelBufferImageBacking::CreateRepresen
   FML_CHECK(config->struct_size == sizeof(ClaySharedImageRepresentationConfig));
   switch (config->type) {
     case kClaySharedImageRepresentationTypeGL:
-#if OS_MAC
+#if OS_MAC && defined(CLAY_ENABLE_CGL)
       return fml::MakeRefCounted<CGLImageRepresentation>(fml::Ref(this));
 #elif OS_IOS
       return fml::MakeRefCounted<EAGLImageRepresentation>(fml::Ref(this));
@@ -107,7 +107,7 @@ fml::RefPtr<SkiaImageRepresentation> CVPixelBufferImageBacking::CreateSkiaRepres
   switch (gr_context->backend()) {
 #if SKIA_ENABLE_GL
     case GrBackendApi::kOpenGL:
-#if OS_MAC
+#if OS_MAC && defined(CLAY_ENABLE_CGL)
       return fml::MakeRefCounted<SkiaGLImageRepresentation>(
           gr_context, fml::MakeRefCounted<CGLImageRepresentation>(fml::Ref(this)));
 #elif OS_IOS
diff --git a/clay/gfx/shared_image/iosurface_image_backing.mm b/clay/gfx/shared_image/iosurface_image_backing.mm
index 5d2d7193..347a2845 100644
--- a/clay/gfx/shared_image/iosurface_image_backing.mm
+++ b/clay/gfx/shared_image/iosurface_image_backing.mm
@@ -15,7 +15,7 @@
 #include "clay/gfx/shared_image/skity_mtl_image_representation.h"
 #include "skity/gpu/gpu_context.hpp"
 #else
-#if OS_MAC
+#if OS_MAC && defined(CLAY_ENABLE_CGL)
 #include "clay/gfx/shared_image/cgl_image_representation.h"
 #endif
 
@@ -95,7 +95,7 @@ fml::RefPtr<SharedImageRepresentation> IOSurfaceImageBacking::CreateRepresentati
     const ClaySharedImageRepresentationConfig* config) {
   FML_CHECK(config->struct_size == sizeof(ClaySharedImageRepresentationConfig));
   switch (config->type) {
-#if OS_MAC && !defined(ENABLE_SKITY)
+#if OS_MAC && defined(CLAY_ENABLE_CGL) && !defined(ENABLE_SKITY)
     case kClaySharedImageRepresentationTypeGL:
       return fml::MakeRefCounted<CGLImageRepresentation>(fml::Ref(this));
 #endif
@@ -120,7 +120,7 @@ fml::RefPtr<SkiaImageRepresentation> IOSurfaceImageBacking::CreateSkiaRepresenta
   switch (gr_context->backend()) {
 #if SKIA_ENABLE_GL
     case GrBackendApi::kOpenGL:
-#if OS_MAC
+#if OS_MAC && defined(CLAY_ENABLE_CGL)
       return fml::MakeRefCounted<SkiaGLImageRepresentation>(
           gr_context, fml::MakeRefCounted<CGLImageRepresentation>(fml::Ref(this)));
 #endif
diff --git a/clay/shell/config.gni b/clay/shell/config.gni
index f151cb9d..9bd9599e 100644
--- a/clay/shell/config.gni
+++ b/clay/shell/config.gni
@@ -24,8 +24,7 @@ declare_args() {
   test_enable_software = shell_enable_software
 }
 
-# TODO(Jinsong): Temporarily Headless only supports OpenGL, more rendering
-# backends will be supported soon.
-if (is_headless) {
+# Headless macOS can use Metal; other headless builds still need OpenGL.
+if (is_headless && !shell_enable_metal) {
   shell_enable_gl = true
 }
diff --git a/core/runtime/common/napi/napi_runtime_proxy.cc b/core/runtime/common/napi/napi_runtime_proxy.cc
index 7463e75b..29e6bb1a 100644
--- a/core/runtime/common/napi/napi_runtime_proxy.cc
+++ b/core/runtime/common/napi/napi_runtime_proxy.cc
@@ -20,7 +20,7 @@
 #include "core/runtime/common/napi/napi_runtime_proxy_quickjs.h"
 #include "core/runtime/js/jsi/quickjs/quickjs_runtime.h"
 
-#if defined(OS_IOS) || defined(OS_OSX)
+#if defined(OS_IOS) || (defined(OS_OSX) && JS_ENGINE_TYPE == 1)
 #include "core/runtime/common/napi/napi_runtime_proxy_jsc.h"
 #include "core/runtime/js/jsi/jsc/jsc_runtime.h"
 #endif
@@ -51,7 +51,7 @@ std::unique_ptr<NapiRuntimeProxy> NapiRuntimeProxy::Create(
       return nullptr;
     }
     case JSRuntimeType::jsc: {
-#if defined(OS_IOS) || defined(OS_OSX)
+#if defined(OS_IOS) || (defined(OS_OSX) && JS_ENGINE_TYPE == 1)
       LOGI("Creating napi proxy jsc");
       auto *jsc_runtime = static_cast<JSCRuntime *>(&runtime);
       auto context = jsc_runtime->getSharedContext();
diff --git a/core/runtime/js/BUILD.gn b/core/runtime/js/BUILD.gn
index 3be32f13..0ff058c4 100644
--- a/core/runtime/js/BUILD.gn
+++ b/core/runtime/js/BUILD.gn
@@ -59,7 +59,9 @@ if (enable_inspector || enable_unittests) {
 
 if (!enable_unittests) {
   if (is_apple && !is_oliver_node_lynx) {
-    js_sources += jsc_sources
+    if (!is_mac || jsengine_type == "jsc") {
+      js_sources += jsc_sources
+    }
     if (!is_mac || !desktop_enable_embedder_layer) {
       js_sources += [
                       "../lepus/bindings/ios/lynx_lepus_module_darwin.h",
diff --git a/platform/darwin/macos/BUILD.gn b/platform/darwin/macos/BUILD.gn
index 719412c1..eb6dcda6 100644
--- a/platform/darwin/macos/BUILD.gn
+++ b/platform/darwin/macos/BUILD.gn
@@ -23,8 +23,10 @@ shared_library("lynx_shared_library") {
     "CoreData.framework",
     "QuartzCore.framework",
     "WebKit.framework",
-    "JavaScriptCore.framework",
   ]
+  if (jsengine_type == "jsc") {
+    frameworks += [ "JavaScriptCore.framework" ]
+  }
 }
 
 group("lynx_common_deps") {
@@ -33,10 +35,12 @@ group("lynx_common_deps") {
     "../../../clay/lynx_adaptor:lynx_adaptor",
     "../../../clay/shell/platform/darwin/macos:flutter_framework_source",
     "../../../clay/shell/platform/embedder:embedder",
-    "../../../core/runtime/common/napi:napi_binding_jsc",
     "../../embedder:embedder",
     "common:common",
   ]
+  if (jsengine_type == "jsc") {
+    deps += [ "../../../core/runtime/common/napi:napi_binding_jsc" ]
+  }
   if (enable_testbench_replay) {
     deps += [ "../../../core/services/replay" ]
   }
